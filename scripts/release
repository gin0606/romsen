#!/usr/bin/env bash
# Tags a release and pushes it together with main, which starts the release workflow.
#
# Usage: scripts/release VERSION   (VERSION is x.y.z)
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "usage: $0 VERSION (x.y.z)" >&2
  exit 2
fi
version="$1"
if ! printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "version must have the form x.y.z, got: $version" >&2
  exit 2
fi
tag="v$version"

if [ "$(git branch --show-current)" != "main" ]; then
  echo "release must run on main" >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "release requires a clean worktree" >&2
  exit 1
fi

git fetch origin main --tags

# HEAD may be ahead of origin/main, because main is pushed together with the tag.
if ! git merge-base --is-ancestor origin/main HEAD; then
  echo "main has diverged from or is behind origin/main" >&2
  exit 1
fi

# ls-remote --exit-code returns 2 when the tag is missing; anything else is a failed query.
if git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1; then
  echo "$tag already exists on origin" >&2
  exit 1
else
  remote_tag_status=$?
fi
if [ "$remote_tag_status" -ne 2 ]; then
  echo "could not check whether $tag exists on origin" >&2
  exit "$remote_tag_status"
fi

swift test --explicit-target-dependency-import-check error

# A local tag left by an earlier attempt whose push failed is reused.
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  if [ "$(git rev-list -n 1 "$tag")" != "$(git rev-parse HEAD)" ]; then
    echo "local $tag does not point at HEAD" >&2
    exit 1
  fi
else
  git tag -a "$tag" -m "Release $version"
fi

git push --atomic origin HEAD:main "refs/tags/$tag"
